# Environment Configuration for OmniWorld

# Backend API
BACKEND_URL=http://localhost:8000
API_VERSION=v1

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/omniworld
REDIS_URL=redis://localhost:6379

# Blockchain Configuration
POLYGON_RPC=https://polygon-rpc.com
POLYGON_MUMBAI_RPC=https://rpc-mumbai.maticvigil.com
CHAIN_ID=137
PRIVATE_KEY=your_private_key_here

# Contract Addresses (update after deployment)
OMNI_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
LAND_NFT_ADDRESS=0x0000000000000000000000000000000000000000
ITEMS_NFT_ADDRESS=0x0000000000000000000000000000000000000000
MARKETPLACE_ADDRESS=0x0000000000000000000000000000000000000000

# API Keys
POLYGONSCAN_API_KEY=your_polygonscan_api_key
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# IPFS Configuration
IPFS_GATEWAY=https://ipfs.io/ipfs/
IPFS_API_URL=https://api.pinata.cloud

# Security
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Game Configuration
DEFAULT_CITY=OmniLanta
FAST_TRAVEL_ENABLED=true
DEBUG_MODE=true

# Oracle Configuration
CHAINLINK_PRICE_FEED=0x0000000000000000000000000000000000000000
UPDATE_INTERVAL_SECONDS=300

# Report Gas Usage
REPORT_GAS=false
